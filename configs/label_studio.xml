<!-- Label Studio config for the external test set. Rules: docs/LABELING_GUIDE.md -->
<View>
  <Header value="One box per text region. 1 speech, 2 thought, 3 narration, 4 sfx, 5 other. See docs/LABELING_GUIDE.md."/>
  <Image name="image" value="$image" zoom="true" zoomControl="true" rotateControl="false"/>
  <RectangleLabels name="label" toName="image" strokeWidth="2" opacity="0.25">
    <Label value="speech" background="#1f77b4" hotkey="1"/>
    <Label value="thought" background="#2ca02c" hotkey="2"/>
    <Label value="narration" background="#ff7f0e" hotkey="3"/>
    <Label value="sfx" background="#d62728" hotkey="4"/>
    <Label value="other" background="#9467bd" hotkey="5"/>
  </RectangleLabels>
</View>
